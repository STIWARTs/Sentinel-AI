# Copy this file to capture-agent/.env and fill in the real values.
# .env is git-ignored - never commit the real key.

# ---- Backend auth ------------------------------------------------------------
# Static key sent in the X-Agent-Key header on every POST to /api/ingest.
# MUST be byte-for-byte identical to AGENT_INGEST_KEY in backend/.env,
# otherwise every flow comes back 401. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AGENT_INGEST_KEY=replace-with-a-random-agent-key

# ---- Optional defaults -------------------------------------------------------
# Backend ingest endpoint. The backend runs on 8888, not 8000: Windows/Hyper-V
# reserves port ranges covering 8000 on many machines (WinError 10013).
# Equivalent to passing --url.
SENTINEL_INGEST_URL=http://localhost:8888/api/ingest

# Interface to capture on, e.g. "Wi-Fi" or "eth0". Leave blank to use scapy's
# default. Run "python agent.py --list-interfaces" to see the names.
# Equivalent to passing --iface.
SENTINEL_CAPTURE_IFACE=
