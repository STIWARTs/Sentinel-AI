# ---- Database ---------------------------------------------------------------
# Postgres connection string. Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://sentinel:sentinel123@localhost:5432/sentinel_ai

# ---- JWT Auth ---------------------------------------------------------------
# Long random string used to sign access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256

# ---- Capture Agent Auth -----------------------------------------------------
# Static key the capture agent sends in the X-Agent-Key header.
# Must match AGENT_INGEST_KEY in capture-agent/.env.
AGENT_INGEST_KEY=replace-with-a-random-agent-key

# ---- AI Copilot (Google Gemini) ---------------------------------------------
# Get your key from https://aistudio.google.com
# Leave blank to disable the copilot feature (backend still runs without it).
GEMINI_API_KEY=

# ---- Email Alerts (optional) ------------------------------------------------
# Fill these in to enable email notifications when a new incident is created.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ---- Telegram Alerts (optional) ---------------------------------------------
# Create a bot via @BotFather, then get the chat ID via the getUpdates API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Seed Admin Script ------------------------------------------------------
# Used only by seed_admin.py. Set before running "python seed_admin.py".
# The script will refuse to run if SEED_ADMIN_PASSWORD is blank.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
